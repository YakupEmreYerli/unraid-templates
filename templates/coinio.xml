<?xml version="1.0"?>
<Container version="2">
  <Name>Coinio</Name>
  <Repository>ghcr.io/yakupemreyerli/coinio:latest</Repository>
  <Registry>https://github.com/YakupEmreYerli/Coinio/pkgs/container/coinio</Registry>
  <Network>bridge</Network>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Icon>https://raw.githubusercontent.com/YakupEmreYerli/Coinio/main/public/icon-512.png</Icon>
  <WebUI>http://[IP]:[PORT:8080]/</WebUI>
  <Overview>Self-hosted subscription and bill tracker. See what is due this week, what is left to pay this month and what the whole year costs, converted to your main currency. Reminders by email, Telegram, Discord, ntfy and more, a calendar and reports, 161 built-in services with logos, import from Wallos, a built-in MCP server for AI assistants and an iPhone widget. Eight languages, no telemetry, no paid tier.</Overview>
  <Support>https://github.com/YakupEmreYerli/Coinio/issues</Support>
  <Project>https://getcoinio.me</Project>
  <TemplateURL>https://raw.githubusercontent.com/YakupEmreYerli/unraid-templates/main/templates/coinio.xml</TemplateURL>
  <ReadMe>https://github.com/YakupEmreYerli/Coinio#readme</ReadMe>
  <Category>Tools:Productivity Other:</Category>
  <ExtraSearchTerms>subscription bills budget finance wallos tracker</ExtraSearchTerms>
  <Changes>First version in Community Applications.</Changes>
  <Date>2026-11-21</Date>
  <License>MIT</License>
  <Screenshot>https://raw.githubusercontent.com/YakupEmreYerli/Coinio/main/docs/screenshots/dashboard.en.webp</Screenshot>
  <Screenshot>https://raw.githubusercontent.com/YakupEmreYerli/Coinio/main/docs/screenshots/calendar.en.webp</Screenshot>
  <Screenshot>https://raw.githubusercontent.com/YakupEmreYerli/Coinio/main/docs/screenshots/reports.en.webp</Screenshot>
  <Config Name="Web UI" Target="8080" Default="8080" Mode="tcp" Description="Web interface" Type="Port" Display="always" Required="true" Mask="false">8080</Config>
  <Config Name="Data" Target="/data" Default="/mnt/user/appdata/coinio" Mode="rw" Description="Database and logos" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/coinio</Config>
  <Config Name="Public URL" Target="COINIO_PUBLIC_URL" Default="" Mode="" Description="Your https address, e.g. https://subs.example.com. Needed for remote AI assistants (OAuth); leave empty if you only use Coinio at home." Type="Variable" Display="always" Required="false" Mask="false"></Config>
  <Config Name="Time zone" Target="TZ" Default="UTC" Mode="" Description="Container time zone, e.g. Europe/Berlin" Type="Variable" Display="always" Required="false" Mask="false">UTC</Config>
</Container>
